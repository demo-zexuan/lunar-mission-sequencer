{
  "name": "lunar-mission-sequencer",
  "version": "1.0.0",
  "description": "月球任务时序仪 · 一台可交互的等距仪器：导轨被弯成阿波罗 11 号的任务剖面，滑架吊着土星五号模型走完全程",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "zexuan.peng <pengzexuan2001@gmail.com>",
  "keywords": [
    "isometric",
    "svg",
    "webgl",
    "apollo",
    "lunar-mission",
    "interactive",
    "anatomy"
  ],
  "scripts": {
    "build": "node build.mjs && node build.mjs --light",
    "audit": "node build.mjs --light --audit",
    "lines": "node scripts/lines.mjs dist/index-light.html && node scripts/lines.mjs dist/index.html",
    "gif": "node scripts/gif.mjs dist/index-light.html --select .lms-stage --width 1280 --height 800 --frames 130 --fps 12 --hold 10 --out out/lunar-mission.gif",
    "capture": "node scripts/capture.mjs dist/index-light.html --out shots/desktop.png --select .lms-stage --width 1400 --height 1000 --scale 1",
    "serve": "node -e \"import('node:http').then(({createServer})=>createServer((q,s)=>{const f=new URL(q.url,'http://x').pathname;const p='.'+(f==='/'?'/dist/index.html':f);import('node:fs').then(({readFileSync})=>{try{s.writeHead(200,{'content-type':p.endsWith('.html')?'text/html':'application/octet-stream'});s.end(readFileSync(p))}catch{s.writeHead(404);s.end('not found')}})}).listen(4173,()=>console.log('http://127.0.0.1:4173/')))\""
  },
  "engines": {
    "node": ">=20"
  }
}
